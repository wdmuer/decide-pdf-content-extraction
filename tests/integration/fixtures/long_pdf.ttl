@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix task: <http://redpencil.data.gift/vocabularies/tasks/> .
@prefix nfo:  <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#> .
@prefix nie:  <http://www.semanticdesktop.org/ontologies/2007/01/19/nie#> .
@prefix mu:   <http://mu.semte.ch/vocabularies/core/> .

<http://example.org/test/task/long-pdf>
    a task:Task ;
    mu:uuid "test-task-long-pdf" ;
    adms:status <http://redpencil.data.gift/id/concept/JobStatus/scheduled> ;
    task:operation <http://lblod.data.gift/id/jobs/concept/TaskOperation/pdf-to-eli> ;
    dct:isPartOf <http://example.org/test/job/long-pdf> ;
    task:inputContainer <http://example.org/test/container/long-pdf> .

<http://example.org/test/container/long-pdf>
    a nfo:DataContainer ;
    mu:uuid "test-container-long-pdf" ;
    task:hasHarvestingCollection <http://example.org/test/collection/long-pdf> .

<http://example.org/test/collection/long-pdf>
    dct:hasPart <http://example.org/test/remote/long-pdf> .

<http://example.org/test/remote/long-pdf>
    a nfo:RemoteDataObject ;
    mu:uuid "test-remote-long-pdf" ;
    nie:url <http://127.0.0.1:8000/long-pdf.pdf> .
